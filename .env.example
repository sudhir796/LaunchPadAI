# Primary LLM provider selection: "gemini", "anthropic", "openai", "groq", or "mock"
LLM_PROVIDER=gemini

# Local Disk Caching: Set to false/0 to bypass cache and force fresh API calls
CACHE_ENABLED=true

# Optional: Cross-provider fallback order (default: primary provider -> remaining providers -> mock)
# LLM_FALLBACK_PROVIDERS=gemini,openai,anthropic

# API KEY ROTATION:
# You can supply multiple keys for any provider. If one key hits quota or rate limits,
# the system automatically rotates to the next key, and then to backup providers.
#
# Method 1: Comma-separated list (e.g., GEMINI_API_KEY=key1,key2,key3)
# Method 2: Numbered variables (e.g., GEMINI_API_KEY_1=key1, GEMINI_API_KEY_2=key2)

# Groq API Keys (llama-3.3-70b-versatile)
GROQ_API_KEY=
# GROQ_API_KEY_1=

# Cerebras API Keys (llama-3.3-70b)
CEREBRAS_API_KEY=
# CEREBRAS_API_KEY_1=

# Gemini API Keys
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Anthropic API Keys
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_1=
# ANTHROPIC_API_KEY_2=

# OpenAI API Keys
OPENAI_API_KEY=
# OPENAI_API_KEY_1=
# OPENAI_API_KEY_2=
